# Copy this file to .env and fill in your real key
# NEVER commit .env to GitHub

# OpenRouter API key: used by both api/chat.js and api/analyze-video.js
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: comma-separated list of origins allowed to call the API cross-origin
ALLOWED_ORIGINS=https://wizgame-nine.vercel.app

# Optional: pin specific models instead of auto-discovering free ones
# FREE_MODELS=provider/model-a:free,provider/model-b:free
# VISION_MODELS=provider/vision-model:free
