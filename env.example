# Copy this file to .env and fill in your real keys
# NEVER commit .env to GitHub

# OpenRouter API key (api/chat.js uses free models with automatic fallback)
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Google Gemini API key (api/analyze-video.js uses Gemini for screen-recording analysis)
# Get free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated origins allowed to call the API cross-origin
ALLOWED_ORIGINS=https://wizgame-nine.vercel.app
